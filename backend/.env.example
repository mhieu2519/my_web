# Database (Neon/Supabase Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET="doi-chuoi-nay-thanh-random-string-that-dai-va-kho-doan"

# Frontend URL (dùng cho CORS)
FRONTEND_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET="personal-blog-images"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Server
PORT=4000
NODE_ENV=development

# Seed admin (chạy: npm run seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
